ENVIRONMENT=development
HOST=0.0.0.0
PORT=8001

DATABASE_URL=sqlite:///./jarvis.db

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120

ENABLE_CLOUD_AI=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

ORCHESTRATION_BUDGET=20
CLOUD_AI_PROVIDER=openai
ENABLED_SCANNERS=security_headers,reflected_input,open_redirect,info_disclosure,cors_misconfig

# Required for anything beyond localhost. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
EXTERNAL_TOOLS_BIN_DIR=/home/youruser/go/bin
EXTERNAL_TOOLS_ENABLED=true
EXTERNAL_TOOL_TIMEOUT_SECONDS=120
NUCLEI_TEMPLATES_SEVERITY=medium,high,critical
FFUF_WORDLIST_PATH=
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b
